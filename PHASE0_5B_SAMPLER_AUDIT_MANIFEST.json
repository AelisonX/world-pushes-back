{
  "experiment": "Phase 0.5b - Realized Importance Sampler Audit",
  "manifest_version": "1.0",
  "status": "FROZEN_BEFORE_AUDIT_RUN",

  "purpose": "Test whether the previously selected tip-dx-targeted defensive proposal performs adequately when particle indices are actually sampled from q, rather than when the full empirical particle bank is evaluated exactly.",

  "historical_scope": {
    "phase0_5_attempt_1_status": "INVALID_BAYES_ESS",
    "phase0_5b_status": "THEORETICAL_PROPOSAL_VALIDATION_RETAINED",
    "historical_results_must_not_be_modified": true,
    "audit_changes_scientific_model": false,
    "audit_changes_physical_model": false,
    "audit_changes_observation_model": false,
    "audit_changes_target_definition": false
  },

  "target_definition": {
    "reference_angle_deg": 45.0,
    "labels": [
      "MATERIAL_YIELD",
      "SUPPORT_SLIP"
    ]
  },

  "proposal": {
    "type": "defensive_tip_dx_mixture",
    "uniform_prior_mixture_weight_alpha": 0.10,
    "tau_m": 0.0002,
    "sampling": "categorical_with_replacement",
    "importance_weight_correction_required": true,
    "target_distribution": "uniform_over_fixed_empirical_class_conditional_particle_bank"
  },

  "particle_bank": {
    "total_particles": 20000,
    "particles_per_class": 10000,
    "particle_seed": 20260930,
    "fixed_for_entire_audit": true,
    "regenerate_per_observation": false
  },

  "audit_dataset": {
    "n_pairs": 500,
    "total_rows": 1000,
    "dataset_seed": 20261001,
    "test_fraction": 0.25,
    "split_seed": 20261002,
    "evaluation_subset_rows": 200,
    "subset_selection": "first_rows_after_deterministic_pair_level_test_split",
    "subset_selected_before_sampler_results": true
  },

  "noise_model": {
    "force_noise_std_N": 0.20,
    "motion_noise_std_m": 0.0002,
    "class_independent": true
  },

  "sampler": {
    "primary_sample_size_per_class": 20000,
    "replicates": 10,
    "sampler_seed_base": 20261010,
    "seed_rule": "sampler_seed_base + observation_index * 100 + replicate_index",
    "uniform_control_enabled": true,
    "targeted_sampler_enabled": true
  },

  "reference": {
    "type": "exact_full_empirical_bank_sum",
    "class_prior": "balanced",
    "reference_is_sampled": false
  },

  "realized_ess_criterion": {
    "minimum_p05_ess_fraction": 0.05,
    "minimum_median_ess_fraction": 0.20
  },

  "posterior_accuracy_criterion": {
    "p95_absolute_posterior_error_max": 0.01,
    "maximum_absolute_posterior_error_max": 0.05
  },

  "evidence_bias_diagnostic": {
    "report_signed_relative_error": true,
    "report_absolute_relative_error": true,
    "pass_rule": "no systematic signed bias larger than Monte Carlo variation across replicates"
  },

  "proposal_normalization": {
    "required": true,
    "absolute_tolerance": 1e-12
  },

  "importance_identity_check": {
    "required": true,
    "interpretation": "algebra sanity check only",
    "absolute_tolerance": 1e-12
  },

  "primary_outputs": [
    "targeted realized ESS fraction by class",
    "uniform realized ESS fraction by class",
    "targeted posterior absolute error versus full-bank reference",
    "uniform posterior absolute error versus full-bank reference",
    "posterior variation across replicates",
    "evidence signed relative error",
    "evidence absolute relative error",
    "proposal normalization check",
    "importance identity check"
  ],

  "forbidden_interpretations": [
    "continuous original prior integrated exactly",
    "Phase 0.5 Attempt 1 retroactively validated",
    "Phase 0.5b historical artifacts rewritten",
    "targeted proposal universally valid for Phase 1 actions",
    "real-world robotic performance demonstrated"
  ],

  "pass_definition": {
    "targeted_realized_ess_must_pass_both_classes": true,
    "posterior_accuracy_must_pass": true,
    "proposal_normalization_must_pass": true,
    "importance_identity_check_must_pass": true,
    "uniform_control_required_for_comparison": true
  },

  "interpretation_if_pass": "The frozen tip-dx-targeted proposal is validated as a finite-sample importance sampler over the fixed empirical class-conditional particle prior used in this audit.",

  "interpretation_if_fail": "The targeted proposal remains theoretically promising but must not be reused as a validated realized sampler for Phase 1 numerical inference."
}